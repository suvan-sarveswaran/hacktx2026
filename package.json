{
  "name": "entertainify",
  "version": "0.1.0",
  "private": true,
  "description": "Turn course text into entertaining narration and visual-ready chunks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "dev": "tsx --env-file-if-exists=.env src/server.ts --dev",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "start:web": "node --env-file-if-exists=.env dist/server.js",
    "start": "node --env-file-if-exists=.env dist/cli.js",
    "test": "tsc && node --test .test-build/tests/*.test.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "compromise": "14.19.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
