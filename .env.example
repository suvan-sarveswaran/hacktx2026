# Copy this file to .env and insert your own API key. Do not commit .env.
# Groq is separate from xAI's Grok. Get a free key at https://console.groq.com/keys.
# Stay on the Free plan to avoid paid API usage; free request/token limits apply.
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional OpenAI API configuration (separately billed; not a ChatGPT login).
# To opt in, change LLM_PROVIDER above to openai and set OPENAI_API_KEY.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# The main UI asks for Groq → Pollinations → ElevenLabs keys at each stage.
# Those keys are not saved. The CLI still uses the provider configuration above.
# Durable lesson storage (source, script, images, voiceover, video versions):
# LESSON_DATA_DIR=output/lessons
# Optional alternative to the bundled FFmpeg executable:
# FFMPEG_PATH=C:/tools/ffmpeg.exe
# PORT=3000
# HOST=127.0.0.1
