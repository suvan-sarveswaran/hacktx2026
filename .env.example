# Copy this file to .env and insert your own API key. Do not commit .env.
# Groq is separate from xAI's Grok. Get a free key at https://console.groq.com/keys.
# Stay on the Free plan to avoid paid API usage; free request/token limits apply.
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional OpenAI API configuration (separately billed; not a ChatGPT login).
# To opt in, change LLM_PROVIDER above to openai and set OPENAI_API_KEY.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional partner video pipeline. See docs/video-pipeline.md for the contract.
# POST <URL>/jobs accepts the original PipelineResult JSON.
# VIDEO_RENDERER_URL=http://127.0.0.1:8000
# VIDEO_RENDERER_TOKEN=your-private-server-token
# PORT=3000
# HOST=127.0.0.1
